# Copy to .env and adjust if needed (never commit .env)
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# PostgreSQL (local Docker only — never commit real secrets)
POSTGRES_DB=collabflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# ZooKeeper / Kafka (Confluent 7.9)
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092

# --- App secrets (gitignored .env only — never commit real values in YAML) ---
# Java bootRun and Docker Compose both read this file from the repo root.
# JWT signing key for access tokens (auth + gateway + platform + task). Min ~32 chars.
JWT_SECRET=ChuPaDupaSecretKeydSQmmDuK70dcClyAHgcdfwedfweftNYqlgPXCTeIpmJ460=
# Client gate: every /api/** request must send header X-API-Key with this value
API_KEY=6e7f9c2b1a3d5eligmanut69420a4b5c
#
# Rotate once if these example values ever lived in committed application.yml:
#   1. Generate new API_KEY + JWT_SECRET (long random strings)
#   2. Put them in your private .env (not .env.example unless you want new local defaults)
#   3. Update Postman / local clients to the new API_KEY
#   4. Restart all Java services (old JWTs become invalid after JWT_SECRET change)

# Redis / Kafka hosts (defaults match docker compose published ports)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# Future app services (host → container later)
# AUTH_SERVICE_PORT=8081
# PLATFORM_SERVICE_PORT=8082
# TASK_SERVICE_PORT=8083
# API_GATEWAY_PORT=8080
# COLLAB_SERVICE_PORT=9081
# REALTIME_SERVICE_PORT=9082
