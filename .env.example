# Copy to .env and adjust if needed (never commit .env)
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# PostgreSQL
POSTGRES_DB=collabflow
POSTGRES_USER=collabflow
POSTGRES_PASSWORD=collabflow
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# ZooKeeper / Kafka (Confluent 7.9)
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092

# Future app services (host → container later)
# AUTH_SERVICE_PORT=8081
# PLATFORM_SERVICE_PORT=8082
# TASK_SERVICE_PORT=8083
# API_GATEWAY_PORT=8080
# COLLAB_SERVICE_PORT=9081
# REALTIME_SERVICE_PORT=9082
