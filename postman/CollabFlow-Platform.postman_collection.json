        },
        {
          "name": "Cannot assign Owner via add member → 403",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// needs a third user id — use random UUID that is not a member; expect FORBIDDEN or NOT_FOUND depending on validation order",
