{
  "info": {
    "_postman_id": "c3d4e5f6-a7b8-9012-cdef-1234567890ab",
    "name": "CollabFlow Platform",
    "description": "Organization APIs via gateway (:8080).\n\n**Setup:** Run Auth → Register (or Login) so env has `accessToken` / `userId`. For member tests also run Auth → Register other user (`otherUserId`).\n\nFolders: happy path CRUD, members, negatives.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiKey", "value": "6e7f9c2b1a3d5e7f8b4fdf31e2f3a4b5c" },
    { "key": "accessToken", "value": "" },
    { "key": "organizationId", "value": "" },
    { "key": "orgSlug", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "ownerRoleId", "value": "a0000000-0000-4000-8000-000000000001" },
    { "key": "adminRoleId", "value": "a0000000-0000-4000-8000-000000000002" },
    { "key": "memberRoleId", "value": "a0000000-0000-4000-8000-000000000003" },
    { "key": "otherUserId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Prefer environment tokens from Auth collection",
          "const envToken = pm.environment.get('accessToken');",
          "if (envToken) pm.collectionVariables.set('accessToken', envToken);",
          "const other = pm.environment.get('otherUserId');",
          "if (other) pm.collectionVariables.set('otherUserId', other);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Roles",
      "item": [
        {
          "name": "List ORGANIZATION roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('three system roles', () => {",
                  "  pm.expect(j.data).to.be.an('array').with.lengthOf(3);",
                  "  const names = j.data.map(r => r.name);",
                  "  pm.expect(names).to.include.members(['Organization Owner','Organization Admin','Organization Member']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/roles?scope=ORGANIZATION"
          }
        },
        {
          "name": "List unknown scope → empty",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('empty list', () => pm.expect(pm.response.json().data).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/roles?scope=WORKSPACE"
          }
        }
      ]
    },
    {
      "name": "1. Org happy path",
      "item": [
        {
          "name": "Create organization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const slug = 'kaung-corp-' + Date.now();",
                  "pm.collectionVariables.set('orgSlug', slug);",
                  "pm.environment.set('orgSlug', slug);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('org payload', () => {",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.data.id).to.be.a('string');",
                  "  pm.expect(j.data.slug).to.eql(pm.collectionVariables.get('orgSlug'));",
                  "  pm.expect(j.data.plan).to.eql('FREE');",
                  "  pm.expect(j.data.active).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('organizationId', j.data.id);",
                  "pm.environment.set('organizationId', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kaung Corp\",\n  \"description\": \"Postman happy path\",\n  \"slug\": \"{{orgSlug}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/organizations"
          }
        },
        {
          "name": "List my organizations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('includes created org', () => {",
                  "  const id = pm.collectionVariables.get('organizationId');",
                  "  pm.expect(j.data.some(o => o.id === id)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/organizations"
          }
        },
        {
          "name": "Get organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('id matches', () => {",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('organizationId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/organizations/{{organizationId}}"
          }
        },
        {
          "name": "Update organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('name updated', () => {",
                  "  pm.expect(pm.response.json().data.name).to.eql('Kaung Corp Updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kaung Corp Updated\",\n  \"description\": \"Updated via Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/organizations/{{organizationId}}"
          }
        }
      ]
    },
