    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Register (unique email)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'kaung+' + Date.now() + '@example.com';",
                  "pm.collectionVariables.set('userEmail', email);",
                  "pm.environment.set('userEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('tokens + user', () => {",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.data.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.data.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.data.userId).to.be.a('string');",
                  "  pm.expect(j.data.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "});",
                  "pm.collectionVariables.set('accessToken', j.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', j.data.refreshToken);",
                  "pm.collectionVariables.set('userId', j.data.userId);",
                  "pm.environment.set('accessToken', j.data.accessToken);",
                  "pm.environment.set('refreshToken', j.data.refreshToken);",
                  "pm.environment.set('userId', j.data.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"name\": \"{{userName}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Pre-request sets a unique email so re-runs do not hit CONFLICT."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('tokens present', () => {",
                  "  pm.expect(j.data.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.data.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('accessToken', j.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', j.data.refreshToken);",
                  "pm.collectionVariables.set('userId', j.data.userId);",
                  "pm.environment.set('accessToken', j.data.accessToken);",
                  "pm.environment.set('refreshToken', j.data.refreshToken);",
                  "pm.environment.set('userId', j.data.userId);",
                  "if (j.data.selectedOrganizationId) { pm.environment.set('organizationId', j.data.selectedOrganizationId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
