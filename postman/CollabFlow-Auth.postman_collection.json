                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orgSlug', 'org-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.environment.set('organizationId', j.data.id);",
                  "pm.collectionVariables.set('organizationId', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Org\",\n  \"slug\": \"{{orgSlug}}\",\n  \"ownerUserId\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/organizations",
            "description": "Owner is the app user — they become org Owner (membership created)."
          }
        },
        {
          "name": "Login app user (org auto-select if one)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('accessToken', j.data.accessToken);",
                  "pm.collectionVariables.set('accessToken', j.data.accessToken);",
                  "pm.environment.set('refreshToken', j.data.refreshToken);",
                  "if (j.data.selectedOrganizationId) {",
                  "  pm.environment.set('organizationId', j.data.selectedOrganizationId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{tempUserPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Select organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('accessToken', j.data.accessToken);",
                  "pm.expect(j.data.selectedOrganizationId).to.eql(pm.environment.get('organizationId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/select-organization"
          }
        }
      ]
    }
  ]
}
